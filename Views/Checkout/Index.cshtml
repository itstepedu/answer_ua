@using AnswerUA.ViewModels
@model CheckoutViewModel

<div class="checkout-container">

    <!-- LEFT SIDE -->
    <div class="checkout-left">

        <!-- User Data -->
        <section class="block">
            <h3>Дані клієнта</h3>

            <div class="info-row">
                <strong>@Model.User.FirstName</strong>
            </div>
            <div class="info-row">
                @Model.User.Email
            </div>
            <div class="info-row">
                @Model.User.PhoneNumber
            </div>

            <button class="btn-small">Інша адреса</button>
        </section>

        <!-- Delivery -->
        <section class="block">
            <h3>Доставка</h3>

            <label class="radio">
                <input type="radio" name="delivery" value="Нова пошта" checked />
                Відділення Нова Пошта — 0 грн
            </label>

            <label class="radio">
                <input type="radio" name="delivery" value="Meest" />
                Кур'єр Meest — 0 грн
            </label>
        </section>

        <!-- Payment -->
        <section class="block">
            <h3>Оплата</h3>

            @if (Model.PaymentMethods.Any())
            {
                foreach (var card in Model.PaymentMethods)
                {
                    <label class="radio">
                        <input type="radio" name="payment" value="@card.Brand @card.Last4" />
                        @card.Brand •••• @card.Last4
                    </label>
                }
            }
            else
            {
                <div class="warning">У вас немає доданих карток.</div>
                <a href="/Profile/PaymentMethods" class="btn-small">Додати картку</a>
            }

            <label class="radio">
                <input type="radio" name="payment" value="GooglePay" />
                Google Pay
            </label>
        </section>

    </div>


    <!-- RIGHT SIDE -->
    <div class="checkout-right">
        <h3>Кошик</h3>

        @foreach (var item in Model.Cart)
        {
            <div class="cart-item-mini">
                <img src="@item.ImageUrl" />
                <div>
                    <div class="name">@item.Name</div>
                    <div>Колір: @item.Color</div>
                    <div>Розмір: @item.Size</div>
                    <div>Кількість: @item.Quantity</div>
                </div>
                <div class="price">@item.Price грн</div>
            </div>
        }

        <div class="summary">
            <div>Сума товарів:</div>
            <div>@Model.Cart.Sum(x => x.Price * x.Quantity) грн</div>

            <div>Доставка:</div>
            <div>0 грн</div>

            <div class="total">Разом:</div>
            <div class="total">@Model.Cart.Sum(x => x.Price * x.Quantity) грн</div>
        </div>

        <form method="post" action="/Checkout/PlaceOrder">
            <input type="hidden" id="deliveryMethod" name="DeliveryMethod" />
            <input type="hidden" id="paymentMethod" name="PaymentMethod" />
            <button class="btn-main">Оплатити</button>
        </form>
    </div>

</div>

<style>
    .checkout-container {
        width: 100%;
        display: grid;
        grid-template-columns: 60% 40%;
        gap: 40px;
        padding: 20px 40px;
    }

    .block {
        background: #fff;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 6px;
        margin-bottom: 20px;
    }

    .cart-item-mini {
        display: flex;
        gap: 15px;
        border-bottom: 1px solid #eee;
        padding: 10px 0;
    }

        .cart-item-mini img {
            width: 70px;
            height: 100px;
            object-fit: cover;
        }

    .summary {
        border-top: 1px solid #ddd;
        margin-top: 20px;
        padding-top: 20px;
        font-size: 15px;
    }

    .total {
        font-weight: bold;
        font-size: 18px;
    }

    .btn-main {
        margin-top: 20px;
        background: black;
        color: white;
        padding: 12px 20px;
        border: none;
        width: 100%;
        border-radius: 4px;
        cursor: pointer;
    }

    .btn-small {
        background: #eee;
        padding: 6px 12px;
        border: none;
        cursor: pointer;
        border-radius: 4px;
        margin-top: 8px;
    }

    .radio {
        display: block;
        padding: 6px 0;
    }
</style>

<script>
    document.querySelector(".btn-main").onclick = function () {
        document.getElementById("deliveryMethod").value =
            document.querySelector("input[name='delivery']:checked").value;

        document.getElementById("paymentMethod").value =
            document.querySelector("input[name='payment']:checked").value;
    }
</script>
