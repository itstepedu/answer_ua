                    <span class="arrow-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon"><polyline points="18 15 12 9 6 15"></polyline></svg>
                    </span>
                </div>

                <div class="promo-content closed">
                    <div class="input-group">
                        <input type="text" placeholder="Промокод" class="promo-input">
                        
                    </div>
                </div>
            </div>

            <div class="parlll"></div>
            <div class="discount-accordion">
                <div class="discount-header">
                    <div class="discount-ti">
                        <span class="discount-icon">
                           <img src="~/images/discount.png" />
                        </span>
                        <span>Хочу використати кошти ANSWEARClub</span>
                    </div>
                    <span class="discount-arrow-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="discount-chevron-icon"><polyline points="18 15 12 9 6 15"></polyline></svg>
                    </span>
                </div>

                <div class="discount-content closed">
                    <div class="discount-group">
                        <input type="text" placeholder="Ціна товарів вже знижена на більш, ніж 50%" class="discount-input">

                    </div>
                </div>
            </div>
            
            <h3 class="summary-title">Всього</h3>

            <div class="summary-row">
                <span>Сума товарів:</span>
                <span id="products-sum">@Model.Sum(x => x.Price * x.Quantity) грн</span>
               
            </div>
            <div id="gift-row" class="gift-row" style="display:none;">
                <span>Подарункова упаковка:</span>
                <span>299 грн</span>
            </div>
           

            <div class="summary-row">
                <span>Сума знижки:</span>
                <span>0 грн</span>
            </div>

            <div class="summary-total">
                <span>Оплата:</span>
                <span id="total-price">@Model.Sum(x => x.Price * x.Quantity) грн</span>
            </div>

            <button class="summary-buy-btn">Купити</button>
            <div class="carttt-summary">
            <div class="duty-message">
                Увага! Вартість замовлення перевищує еквівалент 150 €. На посилку будуть нараховані державні мита у розмірі 6.05 €, <a href="#" class="detailsss-link">Докладніше тут</a>
            </div>
        </div>

            <div class="carttt-summaryyy">
                <div class="info-block">

                    <div class="infoo-item">
                        <span class="info-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="truck-icon"><path d="M10 17H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-2"></path><circle cx="7" cy="19" r="2"></circle><circle cx="17" cy="19" r="2"></circle><path d="M15 17h1"></path></svg>
                        </span>
                        <span class="info-text">Безкоштовна доставка з ЄС (при покупці від 2500 грн)</span>
                    </div>

                    <div class="infoo-item">
                        <span class="info-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="return-icon"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        </span>
                        <span class="info-text">30 днів на повернення</span>
                    </div>

                    <div class="infoo-item">
                        <span class="info-icon club-icon-wrapper">
                            <span class="ac-text">AC</span>
                        </span>
                        <span class="info-text">Заощаджуй з Answear Club</span>
                    </div>

                </div>
            </div>
        </div>

        
    </div>
    <script>
               
        document.addEventListener("DOMContentLoaded", function () {
            const checkbox = document.getElementById("giftWrapCheckbox");
            const giftRow = document.getElementById("gift-row");
            const giftPrice = 299;

            const totalPriceElement = document.getElementById("total-price");
            const productsSumElement = document.getElementById("products-sum");

            let baseProductsSum = parseFloat(productsSumElement.innerText);

            checkbox.addEventListener("change", function () {
                if (checkbox.checked) {
                    giftRow.style.display = "flex";
                    const newTotal = baseProductsSum + giftPrice;
                    totalPriceElement.innerText = newTotal + " грн";
                } else {
                    giftRow.style.display = "none";
                    totalPriceElement.innerText = baseProductsSum + " грн";
                }
            });
        });

                       document.addEventListener('DOMContentLoaded', () => {
            const promoHeader = document.querySelector('.promo-header');
            const promoContent = document.querySelector('.promo-content');

            if (promoHeader && promoContent) {

                // 1. Встановлюємо початковий стан (ЗАКРИТИЙ)
                // Додаємо клас 'closed' до вмісту (якщо його немає в HTML)
                promoContent.classList.add('closed');
                // Прибираємо клас 'collapsed', щоб стрілка була ВНИЗ (закритий стан)
                promoHeader.classList.remove('collapsed');

                // Додатково: встановлюємо стилі, щоб примусово закрити
                promoContent.style.maxHeight = "0";
                promoContent.style.paddingTop = '0';
                promoContent.style.paddingBottom = '0';


                promoHeader.addEventListener('click', () => {

                    // 2. Керування стрілкою: Просто перемикаємо клас 'collapsed'
                    promoHeader.classList.toggle('collapsed');

                    // 3. Розкриваємо/згортаємо вміст
                    if (promoContent.classList.contains('closed')) {
                        // Вміст закритий -> відкриваємо
                        promoContent.classList.remove('closed');

                        // Встановлюємо padding та висоту для відкриття
                        promoContent.style.paddingTop = '15px';
                        promoContent.style.paddingBottom = '15px';
                        promoContent.style.maxHeight = "100px"; // Або promoContent.scrollHeight + "px";

                    } else {
                        // Вміст відкритий -> закриваємо
                        promoContent.style.maxHeight = "0";

                        // Тайм-аут для плавного згортання
                        setTimeout(() => {
                            promoContent.classList.add('closed');
                            promoContent.style.paddingTop = '0';
                            promoContent.style.paddingBottom = '0';
                        }, 10);
                    }
                });
            }
        });


                document.addEventListener('DOMContentLoaded', () => {
            const discountHeader = document.querySelector('.discount-header');
            const discountContent = document.querySelector('.discount-content');

            if (discountHeader && discountContent) {

                // 1. Встановлюємо початковий стан (ЗАКРИТИЙ)
                // Додаємо клас 'closed' до вмісту (якщо його немає в HTML)
                discountContent.classList.add('closed');
                // Прибираємо клас 'collapsed', щоб стрілка була ВНИЗ (закритий стан)
                discountHeader.classList.remove('collapsed');

                // Додатково: встановлюємо стилі, щоб примусово закрити
               discountContent.style.maxHeight = "0";
               discountContent.style.paddingTop = '0';
                discountContent.style.paddingBottom = '0';


               discountHeader.addEventListener('click', () => {

                    // 2. Керування стрілкою: Просто перемикаємо клас 'collapsed'
                    discountHeader.classList.toggle('collapsed');

                    // 3. Розкриваємо/згортаємо вміст
                    if (discountContent.classList.contains('closed')) {
                        // Вміст закритий -> відкриваємо
                        discountContent.classList.remove('closed');

                        // Встановлюємо padding та висоту для відкриття
                       discountContent.style.paddingTop = '15px';
                       discountContent.style.paddingBottom = '15px';
                        discountContent.style.maxHeight = "100px"; // Або promoContent.scrollHeight + "px";

                    } else {
                        // Вміст відкритий -> закриваємо
                       discountContent.style.maxHeight = "0";

                        // Тайм-аут для плавного згортання
                        setTimeout(() => {
                            discountContent.classList.add('closed');
                            discountContent.style.paddingTop = '0';
                           discountContent.style.paddingBottom = '0';
                        }, 10);
                    }
                });
            }
        });
    </script>

  
}