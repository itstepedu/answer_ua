                                <div class="cart-prop">Колір: <span>@item.Color</span></div>
                                <div class="cart-prop">Розмір: <span>@item.Size</span></div>
                                <div class="cart-prop">Ціна: <span>@item.Price грн</span></div>
                                <div class="cart-prop qty-row">
                                    Кількість:

                                    <form method="post" action="/Cart/UpdateQuantity" class="cart-qty">
                                        <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="qty-btn">−</button>
                                        <span class="qty-value">@item.Quantity</span>
                                        <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="qty-btn">+</button>

