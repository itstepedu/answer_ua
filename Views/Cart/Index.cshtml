                </div>

            </div>

            
        </div>
        
        

        <!-- ПРАВИЙ СТАТИЧНИЙ БЛОК -->
        <div class="cart-summary">
            <div class="gift-option">
                <label for="giftWrapCheckbox" class="gift-label">
                    <span class="icon-wrap">
                        <img src="/images/gift.png" />
                    </span>
                    <span class="text-content">
                        <span class="main-text">Запакуй на подарунок</span>
                        <a href="#" class="more-info-link">Більше інформації</a>
                    </span>
                </label>

                <span class="gift-price-wrapper">
                    <span class="gift-price">299 грн</span>
