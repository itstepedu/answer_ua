<script>

    @* ВИБІР РОЗМІРУ *@
    @* document.querySelector(".size-select").addEventListener("change", function () {
        document.getElementById("selectedSize").value = this.value;
    }); *@

    const select_size = document.querySelector(".size-select");
    const hidden_size = document.getElementById("selectedSize");
    hidden_size.value = select_size.value;
    select_size.addEventListener("change", function () {
        hidden_size.value = this.value;
    });

    @* ВИБІР КОЛЬОРУ *@
    const select_color = document.querySelector(".color-select");
    const hidden_color = document.getElementById("selectedColor");
    hidden_color.value = select_color.value;
    select_color.addEventListener("change", function () {
        hidden_color.value = this.value;
    });

    document.addEventListener("DOMContentLoaded", () => {

        const images = @Html.Raw(Json.Serialize(Model.Images));

        let current = 0;

        const big1 = document.getElementById("big1");
        const big2 = document.getElementById("big2");

        const thumbs = document.querySelectorAll(".thumb");

        function update() {
            big1.src = images[current];
            big2.src = images[(current + 1) % images.length];

            thumbs.forEach(t => t.classList.remove("active"));
            thumbs[current].classList.add("active");
        }

        document.getElementById("nextBtn").addEventListener("click", () => {
            current = (current + 1) % images.length;
            update();
        });

        document.getElementById("prevBtn").addEventListener("click", () => {
            current = (current - 1 + images.length) % images.length;
            update();
        });

        thumbs.forEach((thumb, i) => {
            thumb.addEventListener("click", () => {
                current = i;
                update();
            });
        });

        update();
    });
</script>


<script>
    document.getElementById("guideToggle").onclick = function () {

        let content = document.getElementById("guideContent");
        let arrow = document.getElementById("guideArrow");

        if (content.style.display === "block") {
            content.style.display = "none";
            arrow.style.transform = "rotate(0deg)";
        } else {
            content.style.display = "block";
            arrow.style.transform = "rotate(180deg)";
        }
    };

    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".acc-header").forEach(header => {
            header.addEventListener("click", () => {
                const item = header.parentElement;
                item.classList.toggle("active");
            });
        });
    });

    let indexSimilar = 0;
    const cardWidthSimilar = 330;
    const trackSimilar = document.getElementById("similarTrack");
    const cardsSimilar = trackSimilar ? trackSimilar.querySelectorAll(".similar-card") : [];
    const totalSimilar = cardsSimilar.length;

    // захист: якщо раптом немає карток — нічого не робимо
    if (trackSimilar && totalSimilar > 0) {
        // Клонуємо перші 3 картки в кінець (як у твоєму робочому варіанті)
        for (let i = 0; i < 3 && i < totalSimilar; i++) {
            const clone = cardsSimilar[i].cloneNode(true);
            trackSimilar.appendChild(clone);
        }
    }

    function slideSimilar(dir) {
        if (!trackSimilar || totalSimilar === 0) return;

        indexSimilar += dir;

        trackSimilar.style.transition = "transform 0.5s ease";
        trackSimilar.style.transform = `translateX(${-(indexSimilar * cardWidthSimilar)}px)`;

        setTimeout(() => {
            if (indexSimilar >= totalSimilar) {
                trackSimilar.style.transition = "none";
                indexSimilar = 0;
                trackSimilar.style.transform = `translateX(0px)`;
            }
            if (indexSimilar < 0) {
                trackSimilar.style.transition = "none";
                indexSimilar = totalSimilar - 1;
                trackSimilar.style.transform = `translateX(${-(indexSimilar * cardWidthSimilar)}px)`;
            }
        }, 500);
    }


    // =========================
    // 2) НИЖНЯ карусель: trackKarl
    // =========================
    let indexKarl = 0;
    const cardWidthKarl = 330;
    const trackKarl = document.getElementById("trackKarl");
    const cardsKarl = trackKarl ? trackKarl.querySelectorAll(".similar-card") : [];
    const totalKarl = cardsKarl.length;

    if (trackKarl && totalKarl > 0) {
        for (let i = 0; i < 3 && i < totalKarl; i++) {
            const clone = cardsKarl[i].cloneNode(true);
            trackKarl.appendChild(clone);
        }
    }

    function slideKarl(dir) {
        if (!trackKarl || totalKarl === 0) return;

        indexKarl += dir;

        trackKarl.style.transition = "transform 0.5s ease";
        trackKarl.style.transform = `translateX(${-(indexKarl * cardWidthKarl)}px)`;

        setTimeout(() => {
            if (indexKarl >= totalKarl) {
                trackKarl.style.transition = "none";
                indexKarl = 0;
                trackKarl.style.transform = `translateX(0px)`;
            }
            if (indexKarl < 0) {
                trackKarl.style.transition = "none";
                indexKarl = totalKarl - 1;
                trackKarl.style.transform = `translateX(${-(indexKarl * cardWidthKarl)}px)`;
            }
        }, 500);
    }

    let indexViewed = 0;
    const cardWidthViewed = 330;
    const trackViewed = document.getElementById("trackViewed");
    const cardsViewed = trackViewed ? trackViewed.querySelectorAll(".similar-card") : [];
    const totalViewed = cardsViewed.length;

    if (trackViewed && totalViewed > 0) {
        for (let i = 0; i < 3 && i < totalViewed; i++) {
            const clone = cardsViewed[i].cloneNode(true);
            trackViewed.appendChild(clone);
        }
    }

    function slideViewed(dir) {
        if (!trackViewed || totalViewed === 0) return;

        indexViewed += dir;

        trackViewed.style.transition = "transform 0.5s ease";
        trackViewed.style.transform = `translateX(${-(indexViewed * cardWidthViewed)}px)`;

        setTimeout(() => {
            if (indexViewed >= totalViewed) {
                trackViewed.style.transition = "none";
                indexViewed = 0;
                trackViewed.style.transform = `translateX(0px)`;
            }
            if (indexViewed < 0) {
                trackViewed.style.transition = "none";
                indexViewed = totalViewed - 1;
                trackViewed.style.transform = `translateX(${-(indexViewed * cardWidthViewed)}px)`;
            }
        }, 500);
    }

    document.addEventListener("click", e => {
        if (e.target.closest(".heart-iconsstatic")) {
            e.target.closest(".heart-iconsstatic").classList.toggle("active");
        }
    });


    const scrollBtn = document.getElementById("scrollTopBtn");
    window.addEventListener("scroll", () => {
        if (window.scrollY > 600) {
            scrollBtn.classList.add("show");
        } else {
            scrollBtn.classList.remove("show");
        }
    });

    scrollBtn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
    });

</script>

