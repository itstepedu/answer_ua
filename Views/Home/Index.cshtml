<section class="social-media">
    <div class="instagram-1">
        <img id="main-post" style="" src="~/images/instagram_main.jpg" alt="insta" />
        <div class="instagram-info">
            <img src="~/images/instagram.svg" alt="logo" />
            <p>Ми в Інстаграмі</p>
        </div>
    </div>

    <div class="instagram-2">
        <div class="create-your-own">
            <p>Створи свій аутфіт!</p>
            <button class="main-button">У магазин</button>
        </div>
        <div class="mini-posts">
            @foreach (var post in posts)
            {
                <div class="mini-post">
                    <img src="~/images/@post.Picture" alt="insta" />
                    <p>@post.User</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="benefits">
    @foreach (var benefit in benefits)
    {
        <div class="benefit-item">
            <img src="~/images/@benefit.Icon" alt="item" />
            <p class="benefit-name">@benefit.Title</p>
            <p class="benefit-info">@benefit.Description</p>
        </div>
    }
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.scroll').slick({
                infinite: true,
                speed: 300,
                slidesToShow: 8,
                slidesToScroll: 1,
                autoplay: true,
                autoplaySpeed: 2000
                                                                                                                                                                                                                                                                                @* centerMode: true, *@
                @* centerPadding: '45px', *@
                                                                                                                                                                                                                                                                                            });
                                                                                                                                                                                                                                                                                        });


        $(document).ready(function () {
            $('.main-items').slick({
                infinite: true,
                slidesToShow: 4,
                slidesToScroll: 1,
            });
        });
    </script>
}