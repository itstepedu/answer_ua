<section class="main-ad">
    <div class="additional-info">
        <p>Осінь не має бути сірою</p>
        <h1>COLORIZE AUTUMN
            <br />
            ДО -25%
        </h1>

        <button class="main-button">Знижки</button>
    </div>
</section>

@* ДОРОБИТИ *@
<section class="scroll">
    @foreach (var logo in logos)
    {
        <div class="item">
            <a href="#">
                <img src="~/images/@logo" alt="@logo" />
            </a>
        </div>
    }
</section>

@* ДОРОБИТИ *@
<section class="main-items">
    @foreach (var item in autumn_items){
        <div class="main-item">
            <img src="~/images/@item.Picture" alt="item" />
            <p class="main-item-name">@item.ProductName</p>
            <p class="main-item-price">@item.Price грн</p>
        </div>
    }
</section>

<section class="sales-ad">
    <div class="info">
        <h1>ЗНИЖКА -30%
            <br />
            НА ТВОЇ УЛЮБЛЕНІ БРЕНДИ
        </h1>
        <p>Шукай промокод на фішці</p>
        <button class="main-button">Знижки</button>
    </div>

    <div class="picture">
        <img src="~/images/brand_1.jpg" />
    </div>
</section>

<section class="her-stage">
    <div class="additional-info">
        <h1>HER STAGE</h1>
        <p>Твій час сяяти!</p>

        <button class="main-button">Подивитися</button>
    </div>
</section>

<section class="her-stage-items">
    @foreach (var item in herstage_items)
    {
        <div class="main-item">
            <img src="~/images/@item.Picture" alt="item" />
            <p class="main-item-name">@item.ProductName</p>
            <p class="main-item-price">@item.Price грн</p>
        </div>
    }
</section>

