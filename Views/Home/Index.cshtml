<section class="main-ad">
    <div class="additional-info">
        <p>Осінь не має бути сірою</p>
        <h1>COLORIZE AUTUMN
            <br />
            ДО -25%
        </h1>

        <button class="main-button">Знижки</button>
    </div>
</section>

<section class="scroll">
    @foreach (var logo in logos)
    {
        <div class="item">
            <a href="#">
                <img src="~/images/@logo" alt="@logo" />
            </a>
        </div>
    }
</section>

<section class="main-items">
    @foreach (var item in autumn_items)
    {
        <div class="main-item">
            <div class='image-with-info'>
                <img src="~/images/@item.Picture" alt="item" />
                <div class="main-page-item-info">
                    @if (item.hasSale)
                    {
                        <div class="main-page-item-info brown">
                            <p>-25% з кодом ATM*</p>
                        </div>
                    }
                    else
                    @if (item.isPlanetFriendly)
                    {
                        <div class="main-page-item-info mint">
                            <p>Planet friendly</p>
                        </div>
                    }
                </div>
            </div>
            <div class="main-item-info">
                <p class="main-item-name">@item.ProductName</p>
                <p class="main-item-price">@item.Price грн</p>
                <div class="size">
                    @foreach (var size in item.Sizes)
                    {
                        @if (size.Item3)
                        {
                            <a class="main-item-size" href="@size.Item2">@size.Item1</a>
                        }
                        else
                        {
                            <a class="main-item-size not-available" href="@size.Item2">@size.Item1</a>
                        }
                    }
                </div>
            </div>
        </div>
    }
</section>

