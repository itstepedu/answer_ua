@{
    ViewData["Title"] = "Home Page";
    @* var brands = new List<string>
    {
    "brand_template.jpg",
    }; *@

    var benefits = new List<(string Icon, string Title, string Description)>{
("circle.svg", "Безкоштовна доставка", "Від 2500 грн. 4-7 робочих днів"),
("circle.svg", "30 днів на повернення", "Лише оригінальні товари"),
("circle.svg", "Заощаджуй з Answear Club", "Іноді навіть -50%"),
};

}

<section class="main-ad">
    <div class="additional-info">
        <p>Не лише для школярів</p>
        <h1>BACK TO SCHOOL
            <br />
            ДО -25%
        </h1>

        <button class="main-button">Знижки</button>
    </div>
</section>

@* ДОРОБИТИ *@
<section class="scroll">
    @for (int i = 0; i <= 38; i++)
    {
        <div class="item">
            <a href="#">
                <img src="~/images/brand.jpg" alt="brand_template" />
            </a>
        </div>
    }
</section>

@* ДОРОБИТИ *@
<section class="main-items">
    @for (int i = 0; i <= 28; i++)
    {
        <div class="main-item">
            <img src="~/images/item-template.jpg" alt="item" />
            <p class="main-item-name">Назва товару</p>
            <p class="main-item-price">1000 грн</p>
        </div>
    }
</section>

@* ДОРОБИТИ *@
<section class="sales-ad">
    <div class="info">
        <h1>ЗНИЖКА -30%
            <br />
            НА ТВОЇ УЛЮБЛЕНІ БРЕНДИ
        </h1>
        <p>Шукай промокод на фішці</p>
        <button class="main-button">Знижки</button>
    </div>

    <div class="picture">
        <img src="~/images/ad-2.jpg" />
    </div>
</section>

<section class="her-stage">
    <div class="additional-info">
        <h1>HER STAGE</h1>
        <p>Твій час сяяти!</p>

        <button class="main-button">Подивитися</button>
    </div>
</section>

<section class="her-stage-items">
    @for (int i = 0; i < 4; i++)
    {
        <div class="main-item">
            <img src="~/images/item-template.jpg" alt="item" />
            <p class="main-item-name">Назва товару</p>
            <p class="main-item-price">1000 грн</p>
        </div>
    }
</section>

<section class="her-stage shoes-items">
    <div class="additional-info">
        <h1>КРОСІВКИ</h1>
        <p>Твої улюблені бренди в одній добірці: adidas, Puma, Lacoste,<br />Gant, UGG, Michael Kors, Hoff та багато
            інших!</p>

        <button class="main-button">Подивитися</button>
    </div>
</section>

<section class="her-stage-items shoes-items">
    @for (int i = 0; i < 4; i++)
    {
        <div class="main-item">
            <img src="~/images/item-template.jpg" alt="item" />
            <p class="main-item-name">Назва товару</p>
            <p class="main-item-price">1000 грн</p>
        </div>
    }
</section>

<section class="comfortable-shoes">
    <h1>Зручне взуття для осінніх прогулянок</h1>
    <div class="shoes">
        @for (int i = 0; i < 2; i++)
        {
            <div class="main-shoe-item">
                <img src="~/images/shoes-ad.jpg" alt="shoe" />
                <p class="main-item-name">ЧЕРЕВИКИ І НАПІВЧОБОТИ</p>
                <p class="main-item-advice">Для прохолоднішої погоди</p>
                <button class="main-button">Подивитися</button>
            </div>
        }
    </div>
</section>

<section class="her-stage drmartens">
    <div class="additional-info">
        <h1>DR. MARTENS</h1>
        <p>DR. MARTENS<br />Ікона бунтарського духу – культове взуття<br />для тих, хто йде своїм шляхом.</p>

        <button class="main-button">Знижки</button>
    </div>
</section>

<section class="her-stage denim">
    <div class="additional-info">
        <h1>ДЕНІМ</h1>
        <p>На будь-який смак!<br />Лови весь джинсовий одяг в одній добірці</p>

        <button class="main-button">Подивитися</button>
    </div>
</section>

<section class="benefits">
    @foreach (var benefit in benefits)
    {
        <div class="benefit-item">
            <img src="~/images/@benefit.Icon" alt="item" />
            <p class="benefit-name">@benefit.Title</p>
            <p class="benefit-info">@benefit.Description</p>
        </div>
    }
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.scroll').slick({
                infinite: true,
                speed: 300,
                slidesToShow: 8,
                slidesToScroll: 1,
                autoplay: true,
                autoplaySpeed: 2000
                                                                                                                                                                            @* centerMode: true, *@
                @* centerPadding: '45px', *@
                                                                                                                                                                                        });
                                                                                                                                                                                    });


        $(document).ready(function () {
            $('.main-items').slick({
                infinite: true,
                slidesToShow: 4,
                slidesToScroll: 1,
            });
        });
    </script>
}