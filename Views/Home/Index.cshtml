@{
    ViewData["Title"] = "Home Page";
    @* var brands = new List<string>
    {
    "brand_template.jpg",
    }; *@
}

<section class="main-ad">
    <div class="additional-info">
        <p>Не лише для школярів</p>
        <h1>BACK TO SCHOOL
            <br />
            ДО -25%
        </h1>

        <button class="main-button">Знижки</button>
    </div>
</section>


<section class="scroll">
    @* @foreach(var brand in brands)
    {
        <div class="item">
            <a href="#">
                <img src="~/images/@brand" alt="@brand" />
            </a>
        </div>
    } *@



    @for (int i = 0; i <= 38; i++)
    {
        <div class="item">
            <a href="#">
                <img src="~/images/brand.jpg" alt="brand_template" />
            </a>
        </div>
    }

</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.scroll').slick({
                dots: true,
                infinite: true,
                speed: 300,
                slidesToShow: 8,
                slidesToScroll: 1,
                autoplay: true,
                autoplaySpeed: 2000
            });
        });
    </script>
}