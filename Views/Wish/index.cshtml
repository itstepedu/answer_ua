@model List<WishItem>

@if (!Model.Any())
{
    <section class="wish-success">
    <div class="wish-success-container">
        <svg class="wish-heart-icon" viewBox="0 0 24 24" style="width:80px; height:80px; margin-bottom:20px;">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5
                2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09
                C13.09 3.81 14.76 3 16.5 3
                19.58 3 22 5.42 22 8.5
                c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
            fill="none" stroke="#000" stroke-width="1.5" />
        </svg>

        <h2>Ви не маєте товарів в закладці «Мій вибір»</h2>
        <p>
            Додати товар до закладки «Мій вибір» можна за допомогою кнопки сердечка на сторінці товару. 
            Ми дбаємо про порядок у твоїй вкладці — видаляємо товари, яких давно немає в наявності.
        </p>

        <button class="main-button" onclick="location.href='/'">
            На головну
        </button>
    </div>
</section>

}
else
{
    <div class="wish-wrapper">

        <h1 class="wish-title">
            Мій вибір
            <span class="wish-count">Кількість товарів: @Model.Count/100</span>
        </h1>
       
       <div class="wish-top-panel">
            <p class="wish-info">Ми дбаємо про порядок у твоїй вкладці «Мій вибір» — видаляємо товари, яких давно немає в наявності.
            </p>

            <div class="filters-row">
            <div class="filter" data-key="sort">
                <button class="filter-btn">
                    Від найдешевшого <svg class="arrow" id="guideArrow" width="18" height="18" viewBox="0 0 24 24">
                        <polyline points="6 9 12 15 18 9" fill="none" stroke="black" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
                <div class="filter-menu">
                    <label><input type="radio" name="sort" value="price_asc"> Від найдешевшого</label>
                    <label><input type="radio" name="sort" value="price_desc"> Від найдорожчого</label>
                    <button class="ok-btn">OK</button>
                    <a href="#" class="clear-filters" value="newest">Усунути фільтри</a>
                </div>
            </div>
            </div>
            
    </div>
       
        <div id="wish-grid">

        @foreach (var item in Model)
        {
            <a class="product-link" href="/product/@item.ProductId/@item.Name.ToLower().Replace(" ", "-")">
            <div class="product-card">

                <div class="wishlist">
                    <form method="post" action="/Wish/Delete">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <input type="hidden" name="size" value="@item.Size" />
                        <button type="submit" class="heart-btn">
                             <svg class="heart-icon" viewBox="0 0 24 24">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5
                            2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09
                            C13.09 3.81 14.76 3 16.5 3
                            19.58 3 22 5.42 22 8.5
                            c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                            </svg>
                        </button>
                    </form>
                </div>

                <div class="product-image">
                    <img src="@item.ImageUrl" alt="@item.Name" />
                </div>

                <div class="product-info">
                    <h4>@item.Name</h4>
                    <p class="price">
                        <span class="new">@item.Price грн</span>
                    </p>
                </div>

            </div>
        </a>
        }

        </div>
    </div>
}

<style>
    @@font-face {
        font-family: 'Euclid Circular A';
        src: url('../fonts/euclid-circular-a/Euclid Circular A Regular.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
    }

    p, span, label, h1, h2, h3, h4, ul li, .filter-btn, .clear-filters{
        font-family: 'Euclid Circular A', sans-serif;
    }

    @* ФІЛЬТР *@
    .filters-row {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin: 8px 0 16px 0;

        justify-content: space-between;

    }

    .filter {
        position: relative;
    }

    .filters-row .filter .filter-menu input[type="radio"] {
        -webkit-appearance: none; 
        -moz-appearance: none; 
        appearance: none; 
        width: 20px;
        height: 20px;
        border: 1px solid #b7b7b7;
        border-radius: 0;
        background-color: #fff;
        transition: all 0.5s;
        flex-shrink: 0;
    }


    .filters-row .filter .filter-menu input[type="radio"]:checked {
        border: 1px solid #000000;
        background-color: #000;
        box-shadow: inset 0 0 0 2px white;
    }

    .filter-btn {
        border: none;
        background: transparent;
        padding: 8px 12px;
        border-bottom: 2px solid #000;
        cursor: pointer;
        text-align: left;
    }

    .filter-menu {
        display: none;
        position: absolute;
        top: 36px;
        left: 0;
        background: #fff;
        border: 1px solid #ddd;
        box-shadow: 0 6px 18px rgba(0, 0, 0, .08);
        padding: 12px;
        min-width: 240px;
        z-index: 10;
        flex-direction: column;
        gap: 8px
    }

    .filter-menu label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        cursor: pointer;
        padding: 6px 0;
    }

    .filter-menu.scrollable {
        max-height: 260px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #999 #f1f1f1;
    }

    .filter-menu.scrollable::-webkit-scrollbar {
        width: 6px;
    }

    .filter-menu.scrollable::-webkit-scrollbar-thumb {
        background: #aaa;
        border-radius: 4px;
    }

    .filter .ok-btn {
        margin-top: 8px;
        margin-bottom: 8px;
    }

    .clear-filters {
        font-size: .875rem;
        line-height: 1.375rem;
        padding: 11px 48px;
        border: none;
        transform: 0.3s ease;
    }

    .clear-filters:hover {
        color: #757575;
    }


    @* ЯКЩО ТОВАР Є *@
    .product-card {
        position: relative;
        transition: .25s;
    }

    .product-card:hover {
        transform: translateY(-4px);
    }

    .product-link {
        text-decoration: none;
        color: inherit;
    }

    .product-image {
        position: relative;
    }

    .product-image img {
        width: 100%;
        max-width: 260px;
        height: 374px;
        display: block;
    }

    .product-info {
        margin-top: 12px;
        background-color: white;
        transition: 0.3s ease-in-out;
    }

    .product-info h4 {
        margin-bottom: 7px;
        font-size: 12px;
        color: #000000;
        font-weight: 400;
    }

    .price {
        margin-top: 4px;
        font-size: 14px;
        font-weight: 400;
        margin-bottom: 0;
        color: #000000;
    }

    .wishlist {
        position: absolute;
        top: 12px;
        right: 30px;
        z-index: 5;
    }

    .heart-icon {
        width: 32px;
        height: 32px;
        stroke: #222;
        fill: #000;
        stroke-width: 2;
        transition: .3s ease;
        cursor: pointer;
    }

    .wishlist:hover .heart-icon {
        stroke: #000;
        fill: transparent;
    }

    .heart-btn {
        all: unset;
    }

    @* ЯКЩО ТОВАРУ НЕМАЄ *@
    .wish-success {
        padding: 40px 20px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .wish-success-container {
        text-align: center;
        max-width: 600px;
        width: 100%;
        background: #fff;
        padding: 50px 30px;
    }

    .wish-success-container h2 {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 16px;
    }

    .wish-success-container p {
        font-size: 16px;
        color: #555;
        margin-bottom: 32px;
        line-height: 1.5;
    }

    .wish-success-container .wish-heart-icon {
        width: 80px;
        height: 80px;
        margin-bottom: 24px;
    }

    .main-button:hover {
        background-color: #333;
    }

    .wish-wrapper, .wish-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 32px 16px;
        font-family: 'Arial', sans-serif;
        color: #111;
    }

    .wish-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .wish-count, .wish-empty-text {
        font-size: 16px;
        font-weight: 400;
        color: #666;
    }

    .wish-info {
        font-size: 14px;
        color: #666;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
    }

    .wish-sort {
        display: flex;
        align-items: center;
        margin-bottom: 24px;
        gap: 8px;
    }

    .wish-sort select {
        padding: 6px 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
    }

    #wish-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
    }

</style>

<script>
    // ФІЛЬТРУВАННЯ
    document.addEventListener("DOMContentLoaded", () => {
        const grid = document.getElementById("wish-grid");

        document.querySelectorAll(".filter-btn").forEach(btn => {
            btn.addEventListener("click", e => {
                e.stopPropagation();
                const menu = btn.nextElementSibling;
                document.querySelectorAll(".filter-menu").forEach(m => {
                    if (m !== menu) m.style.display = "none";
                });
                menu.style.display = menu.style.display === "block" ? "none" : "block";
            });
        });

    // Закриття при кліку поза меню
    document.addEventListener("click", e => {
        if (!e.target.closest(".filter")) {
            document.querySelectorAll(".filter-menu").forEach(m => m.style.display = "none");
        }
    });

    function sortProducts(sortType) {
        const items = Array.from(grid.children);

        let sortedItems;
        switch(sortType) {
            case "price_asc":
                sortedItems = items.sort((a, b) => {
                    const priceA = parseFloat(a.querySelector(".price .new").textContent);
                    const priceB = parseFloat(b.querySelector(".price .new").textContent);
                    return priceA - priceB;
                });
                break;
            case "price_desc":
                sortedItems = items.sort((a, b) => {
                    const priceA = parseFloat(a.querySelector(".price .new").textContent);
                    const priceB = parseFloat(b.querySelector(".price .new").textContent);
                    return priceB - priceA;
                });
                break;
            case "newest":
            default:
                sortedItems = items; 
        }

        sortedItems.forEach(item => grid.appendChild(item));
    }

    // Обробка кнопки OK
    document.querySelectorAll(".ok-btn").forEach(btn => {
        btn.addEventListener("click", e => {
            e.preventDefault();

            const menu = btn.closest(".filter-menu");
            const checkedInput = menu.querySelector('input[type="radio"]:checked') 
                     || menu.querySelector('input[value="newest"]');


            if (checkedInput) {
                sortProducts(checkedInput.value);
            }

            menu.style.display = "none"; 
        });
    });

    // Кнопка Усунути фільтри
    document.querySelectorAll(".clear-filters").forEach(btn => {
    btn.addEventListener("click", e => {
        e.preventDefault();
        const menu = btn.closest(".filter-menu");
        menu.querySelectorAll("input[type='radio']").forEach(i => i.checked = false);

        const defaultInput = menu.querySelector('input[value="newest"]');
        if (defaultInput) defaultInput.checked = true;

        sortProducts("newest");
        menu.style.display = "none";
    });
});

});
</script>
