                    pTypeSlug == "odjag" ? "Одяг" :
                    pTypeSlug == "vzuttya" ? "Взуття" :
                    pTypeSlug == "aksesuary" ? "Аксесурари" : ""
                    )
                </a>  
                }
                @if (!string.IsNullOrEmpty(Model.SubcategoryName))
                {
                    <span>›</span>
                    <span>@pageTitle</span>
                }
            </nav>

