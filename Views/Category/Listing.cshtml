            @{
            string h1;

            if (!string.IsNullOrEmpty(Model.SubcategoryName))
            {
            // Якщо є підкатегорія — додаємо префікс
            string prefix;
            if (targetSlug == "vona") prefix = "Жіночі";
            else if (targetSlug == "vin") prefix = "Чоловічі";
            else if (targetSlug == "dity") prefix = "Дитячі";
            else prefix = "Для дому";

            h1 = prefix + " " + Model.SubcategoryName.ToLower();
            }
            else if (!string.IsNullOrEmpty(Model.ProductTypeSlug))
            {
            // Якщо немає підкатегорії, але є тип товару
            string prefix;
            if (targetSlug == "vona") prefix = "Жіноче";
            else if (targetSlug == "vin") prefix = "Чоловіче";
            else if (targetSlug == "dity") prefix = "Дитяче";
            else prefix = "Для дому";

            string typeName = Model.ProductTypeSlug switch
            {
            "odjag" => "одяг",
            "vzuttya" => "взуття",
            "aksesuary" => "аксесуари",
            _ => Model.ProductTypeSlug
            };

            h1 = prefix + " " + typeName;
            }
            else
            {
            // Якщо немає ні підкатегорії, ні типу
            h1 = targetSlug switch
            {
            "vona" => "Вона",
            "vin"  => "Він",
            "dity" => "Діти",
            "dim"  => "Дім",
            _      => "Каталог товарів"
            };
            }
            }

