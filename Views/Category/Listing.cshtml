            @await Html.PartialAsync("_ProductGrid", Model.Products)
        </div>

        <div class="pagination">
            <a href="#" class="arrow prev disabled">←</a>
            <a href="#" class="page active">1</a>
            <a href="#" class="page">2</a>
            <a href="#" class="page">3</a>
            <span class="dots">...</span>
            <a href="#" class="page">68</a>
            <a href="#" class="arrow next">→</a>
        </div>

        <!-- ======= КНОПКА НАВЕРХ ======= -->
        <button class="scroll-top" id="scrollTopBtn" aria-label="Наверх">↑</button>

        <div class="seo-description">
            @if (targetSlug == "vona")
            {
                <div class="seo-links">
                    <span>Подивитись також:</span>
                    <a href="/k/vona/odjag/bluzy">Блузки</a>
                    <a href="/k/vona/odjag/sorochky">Сорочки</a>
                </div>

                <h2>Жіночі блузки — діловий чи повсякденний образ?</h2>
                <p>Жіноча блузка — це полегшена сорочка приталеного крою. Вона відрізняється від класичної жіночої сорочки —
                    комір та манжети. Блузка може застібатися на ґудзики або їх зовсім не мати, наприклад — туніки.</p>
                <p>Блузки носять не лише на роботу. Дуже часто їх використовують для легких, невимушених, але дуже жіночних
                    нарядів. Тому блузка — це універсальний предмет гардеробу, який впишеться у більшість ділових та
                    повсякденних стилів.</p>

                <h2>Жіночі блузки — важливість її наявності</h2>
                <p>Говорячи про блузку, варто розуміти, що йдеться про річ, без якої не обходиться жоден жіночий гардероб.
                    Вона використовується скрізь і цілий рік. Не пов’язана із сезонністю, тому важливо мати кілька моделей
                    на різну погоду.</p>

                <h3>Блузка: популярні види</h3>
                <ul>
                    <li><b>Моделі з бантом на комірі</b> — блузка з коміром аскот.</li>
                    <li><b>Блузка з жабо</b> — додає романтичності, підійде для офісу та вечірнього образу.</li>
                    <li><b>Блузка з запахом</b> — фіксується за допомогою пояса.</li>
                    <li><b>Оверсайз</b> — класична сорочка у збільшеному розмірі.</li>
                    <li><b>Блузка реглан</b> — м’який крій із плавною лінією плечей.</li>
                    <li><b>Туніка</b> — довга блузка, яку можна носити з легінсами або вузькими джинсами.</li>
                </ul>

                <h3>Як вибрати блузку за фігурою</h3>
                <p>Вибір блузки залежить від типу фігури. Для дівчат із пишним бюстом пасуватиме V-подібний виріз, для
                    мініатюрних — моделі з рюшами або бантами. Важливо обирати тканину, яка підкреслить фігуру, але не
                    обтягує надмірно.</p>
            }
            else if (targetSlug == "vin")
            {
                <div class="seo-links">
                    <span>Подивитись також:</span>
                    <a href="/k/vin/odjag/sorochky">Сорочки</a>
                    <a href="/k/vin/odjag/futbolky">Футболки</a>
                </div>

                <h2>Чоловічі сорочки — основа гардеробу</h2>
                <p>Чоловіча сорочка — це універсальний елемент, який підходить і для офісу, і для неформальних подій.
                    Класична біла або блакитна сорочка залишається беззаперечним символом стилю.</p>
                <p>Сорочки бувають різних кроїв — від приталених slim fit до вільних oversize, і кожен варіант має свої
                    переваги. Для повсякденного стилю підходять моделі з деніму, льону чи фланелі.</p>

                <h2>Як вибрати чоловічу сорочку</h2>
                <ul>
                    <li><b>Класична сорочка</b> — для офіційних подій та роботи.</li>
                    <li><b>Повсякденна</b> — із м’яких матеріалів, як-от льон або денім.</li>
                    <li><b>Фланелева</b> — тепла та зручна на осінь і зиму.</li>
                    <li><b>Oversized</b> — трендовий вільний крій для сучасного стилю.</li>
                </ul>

                <p>Правильно підібрана сорочка допоможе створити як діловий, так і повсякденний образ. Поєднуй її з брюками,
                    джинсами або шортами — залежно від нагоди.</p>

            }
        </div>

    </main>

@section Styles {
        <style>
            @@font-face {
                font-family: 'Euclid Circular A';
                src: url('../fonts/euclid-circular-a/Euclid Circular A Regular.ttf') format('truetype');
                font-weight: normal;
                font-style: normal;
            }

            h2,
            h3,
            p,
            ul li,
            .seo-links,
            .breadcrumbs,
            .catalog-title,
            .product-count {
                font-family: 'Euclid Circular A', sans-serif;
            }

            .catalog-page {
                display: grid;
                grid-template-columns: 300px 1fr;
                gap: 24px;
                max-width: auto;
                margin: 0 auto;
                padding: 8px 16px;
                padding-top: 65px;
            }

            .clear-filters {
                font-size: .875rem;
                line-height: 1.375rem;
                padding: 11px 48px;
                border: none;
                transform: 0.3s ease;
            }

            .clear-filters:hover {
                color: #757575;
            }

            .left-side {
                position: sticky;
                top: 84px;
                align-self: start;
                max-height: calc(100vh - 100px);
                overflow: auto;
                padding-right: 16px;
            }

            .right-side {
                min-height: 400px;
            }

            .filters-row {
                display: flex;
                gap: 16px;
                flex-wrap: wrap;
                margin: 8px 0 16px 0;

                justify-content: space-between;

            }

            .filter {
                position: relative;
            }

            .filters-row .filter .filter-menu input[type="checkbox"],
            .filters-row .filter .filter-menu input[type="radio"] {
                -webkit-appearance: none; 
                -moz-appearance: none; 
                appearance: none; 
                width: 20px;
                height: 20px;
                border: 1px solid #b7b7b7;
                border-radius: 0;
                background-color: #fff;
                transition: all 0.5s;
                flex-shrink: 0;
            }

            .filters-row .filter .filter-menu input[type="checkbox"]:checked,
            .filters-row .filter .filter-menu input[type="radio"]:checked {
                border: 1px solid #000000;
                background-color: #000;
                box-shadow: inset 0 0 0 2px white;
            }


            @* .filters-row .filter .filter-menu input[type="checkbox"]{
                -webkit-appearance: none; 
                -moz-appearance: none;
                appearance: none;
            } *@

            .filter-btn {
                border: none;
                background: transparent;
                padding: 8px 12px;
                border-bottom: 2px solid #000;
                cursor: pointer;
                text-align: left;

            }

            .filter-menu {
                display: none;
                position: absolute;
                top: 36px;
                left: 0;
                background: #fff;
                border: 1px solid #ddd;
                box-shadow: 0 6px 18px rgba(0, 0, 0, .08);
                padding: 12px;
                min-width: 240px;
                z-index: 10;
                flex-direction: column;
                gap: 8px
            }

            .filter-menu label {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 14px;
                cursor: pointer;
                padding: 6px 0;
            }

            .filter-menu.scrollable {
                max-height: 260px;
                overflow-y: auto;
                scrollbar-width: thin;
                scrollbar-color: #999 #f1f1f1;
            }

            .filter-menu.scrollable::-webkit-scrollbar {
                width: 6px;
            }

            .filter-menu.scrollable::-webkit-scrollbar-thumb {
                background: #aaa;
                border-radius: 4px;
            }

            .filter .ok-btn {
                margin-top: 8px;
                margin-bottom: 8px;
            }

            .product-link {
                text-decoration: none;
                color: inherit;
            }

            .product-grid {
                display: grid;
                @* grid-template-columns: repeat(4, minmax(0, 1fr)); *@
                grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
                gap: 20px
            }

            .product-card {
                background: #fff;
                overflow: hidden;
                cursor: pointer;
                padding-bottom: 10px;
                position: relative;
                transition: .25s;
            }

            .product-image {
                position: relative;
            }

            .product-image img {
                width: 100%;
                max-width: 260px;
                height: 374px;
                display: block;
            }

            .discount {
                position: absolute;
                bottom: 12px;
                left: 12px;
                background: #b6002c;
                color: white;
                padding: 4px 8px;
                border-radius: 6px;
                font-size: 13px;
                font-weight: 600;
            }

            .wishlist {
                position: absolute;
                top: 12px;
                right: 12px;
                z-index: 5;
            }

            .heart-icon {
                width: 32px;
                height: 32px;
                stroke: #222;
                fill: none;
                stroke-width: 2;
                transition: .3s ease;
            }

            /* Чорне при наведенні */
            .wishlist:hover .heart-icon {
                stroke: #000;
                fill: #000;
            }

            /* Назва + ціна */
            .product-info {
                @* ТУТ ПОЧАТОК АНІМАЦІЇ *@
                margin-top: 12px;
                background-color: white;
                transition: 0.3s ease-in-out;
                transform: translateY(0);
                @* transition: .25s; *@
            }

            .product-info h4 {
                margin-bottom: 7px;
                font-size: 12px;
                color: #000000;
                font-weight: 400;
            }

            .price {
                margin-top: 4px;
                font-size: 14px;
                font-weight: 400;
                margin-bottom: 0;
                color: #000000;
            }

            @* .price .new {
                font-size: 18px;
                font-weight: 700;
                color: #000;
            } *@

                        .sizes {
                display: flex;
                opacity: 0;
                transform: translateY(5px);
                transition: .25s;
                @* padding: 5px; *@
                    }

            .sizes span {
                font-size: .75rem;
                font-weight: 500;
                text-decoration: none;
                padding-left: 7px;
                padding-right: 7px;
                color: black;
                border-right: 1px solid #D1D5DB;
            }

            .sizes span:last-child {
                border-right: none;
            }

            .sizes span:first-child {
                padding-left: 0;
            }

            /* ХОВЕР — ВИЇЖДЖАЮТЬ РОЗМІРИ */
            .product-card:hover .sizes {
                opacity: 1;
            }

            .product-card:hover .product-info {
                transform: translateY(-45px);
            }

            .seo-description {
                margin-top: 60px;
                border-top: 1px solid #eee;
                padding-top: 40px;
                font-family: "Open Sans", sans-serif;
                color: #222;
                line-height: 1.6;
                max-width: 900px;
            }

            .seo-links {
                display: flex;
                align-items: center;
                gap: 16px;
                margin-bottom: 24px;
                font-size: 15px;
            }

            .seo-links span {
                font-weight: 600;
            }

            .seo-links a {
                color: #111;
                text-decoration: none;
                border-bottom: 1px solid transparent;
                transition: 0.2s;
            }

            .seo-links a:hover {
                border-color: #111;
            }

            .seo-description h2 {
                font-size: 22px;
                font-weight: 700;
                margin-top: 24px;
                margin-bottom: 12px;
            }

            .seo-description h3 {
                font-size: 18px;
                font-weight: 600;
                margin-top: 24px;
                margin-bottom: 12px;
            }

            .seo-description p {
                margin-bottom: 12px;
                font-size: 15px;
            }

            .seo-description ul {
                margin-left: 20px;
                margin-bottom: 20px;
            }

            .seo-description li {
                margin-bottom: 6px;
                font-size: 15px;
            }

            /* ======= Верхня частина сторінки ======= */
            .catalog-header {
                margin-bottom: 32px;
                @* border-bottom: 1px solid #f0f0f0; *@
                padding-bottom: 12px;
                font-family: "Open Sans", sans-serif;
            }

            /* Хлібні крихти */
            .breadcrumbs {
                font-size: 14px;
                color: #666;
                margin-bottom: 12px;
            }

            .breadcrumbs a {
                color: #111;
                text-decoration: none;
                transition: .2s;
            }

            .breadcrumbs a:hover {
                text-decoration: underline;
            }

            .breadcrumbs span {
                margin: 0 6px;
                color: #aaa;
            }

            /* Заголовок та кількість товарів */
            .catalog-title {
                display: flex;
                align-items: baseline;

                flex-wrap: wrap;
                gap: 8px;
            }

            .catalog-title h1 {
                font-size: 28px;
                font-weight: 700;
                color: #111;
                margin: 0;
            }

            .product-count {
                font-size: 14px;
                color: #555;
                padding-right: 750px;
            }

            /* ======= Пагінація ======= */
            .pagination {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 6px;
                margin: 40px 0 60px;
                font-family: "Open Sans", sans-serif;
            }

            .pagination a,
            .pagination span {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                text-decoration: none;
                color: #111;
                font-size: 15px;
                transition: background 0.2s, color 0.2s;
            }

            .pagination a:hover {
                background: #f5f5f5;
            }

            .pagination .active {
                background: #111;
                color: #fff;
                font-weight: 600;
            }

            .pagination .arrow {
                font-size: 18px;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background: #fff;
                color: #333;
                text-align: center;
                line-height: 34px;
                border: 1px solid transparent;
            }

            .pagination .arrow:hover {
                border-color: #ccc;
            }

            .pagination .disabled {
                opacity: 0.4;
                pointer-events: none;
            }

            .pagination .dots {
                padding: 0 6px;
                color: #aaa;
            }

            /* ======= Кнопка вгору ======= */
            .scroll-top {
                position: fixed;
                bottom: 40px;
                right: 40px;
                width: 44px;
                height: 44px;
                border: none;
                border-radius: 50%;
                background-color: #111;
                color: #fff;
                font-size: 22px;
                font-weight: 600;
                cursor: pointer;
                opacity: 0;
                visibility: hidden;
                transition: 0.3s;
                z-index: 1000;
            }

            .scroll-top:hover {
                background-color: #333;
            }

            .scroll-top.show {
                opacity: 1;
                visibility: visible;
            }
        </style>
}

@section Scripts {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                // Відкриття/закриття меню фільтра
                document.querySelectorAll(".filter-btn").forEach(btn => {
                    btn.addEventListener("click", e => {
                        e.stopPropagation();
                        const menu = btn.nextElementSibling;
                        document.querySelectorAll(".filter-menu").forEach(m => {
                            if (m !== menu) m.style.display = "none";
                        });
                        menu.style.display = menu.style.display === "block" ? "none" : "block";
                    });
                });

                // Закриття при кліку поза меню
                document.addEventListener("click", e => {
                    if (!e.target.closest(".filter")) {
                        document.querySelectorAll(".filter-menu").forEach(m => m.style.display = "none");
                    }
                });

                function collectFilters() {
                    @* const f = {
                        targetId: @Model.TargetId,
                        productTypesId: @Model.ProductTypesId,
                        BrandsId: [],
                        Сolor: [],
                        size: [],
                        SubcategoriesId: [], // нове поле
                        sort: null,
                        priceMin: null,
                        priceMax: null,
                        page: 1,
                        pageSize: 24
                    };

                    document.querySelectorAll('.filter[data-key="subcategory"] input:checked').forEach(i => f.subcategoriesId.push(parseInt(i.value)));
                    document.querySelectorAll('.filter[data-key="brand"] input:checked').forEach(i => f.brandsId.push(parseInt(i.value)));
                    document.querySelectorAll('.filter[data-key="color"] input:checked').forEach(i => f.color.push(i.value));
                    document.querySelectorAll('.filter[data-key="size"] input:checked').forEach(i => f.size.push(i.value));

                    const s = document.querySelector('.filter[data-key="sort"] input:checked');
                    if (s) f.sort = s.value;

                    const p = document.querySelector('.filter[data-key="price"] input:checked');
                    if (p) {
                        const [min, max] = p.value.split('-');
                        if (min) f.priceMin = parseFloat(min);
                        if (max) f.priceMax = max === '' ? null : parseFloat(max);
                    } *@
                                                                    const f = {
                        TargetId: @Model.TargetId,
                        ProductTypesId: @Model.ProductTypesId,
                        BrandsId: [],
                        Color: [],
                        Size: [],
                        SubcategoriesId: [],
                        Sort: null,
                        PriceMin: null,
                        PriceMax: null,
                        Page: 1,
                        PageSize: 24
                    };

                    document.querySelectorAll('.filter[data-key="subcategories"] input:checked')
                        .forEach(i => f.SubcategoriesId.push(parseInt(i.value)));
                    document.querySelectorAll('.filter[data-key="brand"] input:checked')
                        .forEach(i => f.BrandsId.push(parseInt(i.value)));
                    document.querySelectorAll('.filter[data-key="colors"] input:checked')
                        .forEach(i => f.Color.push(i.value));
                    document.querySelectorAll('.filter[data-key="sizes"] input:checked')
                        .forEach(i => f.Size.push(i.value));

                    const s = document.querySelector('.filter[data-key="sort"] input:checked');
                    if (s) f.Sort = s.value;

                    const p = document.querySelector('.filter[data-key="price"] input:checked');
                    if (p) {
                        const [min, max] = p.value.split('-');
                        if (min) f.PriceMin = parseFloat(min);
                        if (max) f.PriceMax = max === '' ? null : parseFloat(max);
                    }

                    console.log(f);
                    return f;
                }

                // Кнопка OK в меню фільтра
                document.querySelectorAll(".ok-btn").forEach(btn => {
                    btn.addEventListener("click", async e => {
                        e.stopPropagation();
                        btn.closest(".filter-menu").style.display = "none";
                        await reloadProducts();
                    });
                });

                // Кнопка Усунути фільтри
                document.querySelectorAll(".clear-filters").forEach(btn => {
                    btn.addEventListener("click", async e => {
                        e.preventDefault();
                        e.stopPropagation();

                        const menu = btn.closest(".filter-menu");
                        menu.querySelectorAll("input").forEach(i => {
                            if (i.type === "checkbox" || i.type === "radio") {
                                i.checked = false;
                            }
                        });

                        btn.closest(".filter-menu").style.display = "none";

                        await reloadProducts();
                    });
                });

                // Завантаження товарів після фільтрації
                async function reloadProducts() {
                    const payload = collectFilters();
                    const res = await fetch("/k/api/products", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(payload)
                    });
                    const html = await res.text();
                    document.getElementById("product-grid").innerHTML = html;
                }

                // Клік по підкатегорії (Одяг / Взуття / Аксесуари)
                document.querySelectorAll("[data-ptype-id]").forEach(a => {
                    a.addEventListener("click", async e => {
                        e.preventDefault();
                        const id = parseInt(a.dataset.ptypeId);
                        const f = collectFilters();
                        f.productTypesId = id;

                        const res = await fetch("/k/api/products", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(f)
                        });

                        const html = await res.text();
                        document.getElementById("product-grid").innerHTML = html;
                    });
                });
            });

        </script>
        <script>
            const scrollBtn = document.getElementById("scrollTopBtn");
            window.addEventListener("scroll", () => {
                if (window.scrollY > 600) {
                    scrollBtn.classList.add("show");
                } else {
                    scrollBtn.classList.remove("show");
                }
            });

            scrollBtn.addEventListener("click", () => {
                window.scrollTo({ top: 0, behavior: "smooth" });
            });
        </script>

}