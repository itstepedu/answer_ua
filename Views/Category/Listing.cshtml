                    <label><input type="checkbox" name="Color" value="Коричневий"> Коричневий </label>
                    <label><input type="checkbox" name="Color" value="Золотий"> Золотий </label>
                    <label><input type="checkbox" name="Color" value="Срібний"> Срібний </label>
                    <button class="ok-btn">OK</button>
