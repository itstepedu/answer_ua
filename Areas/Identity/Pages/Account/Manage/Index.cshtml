<script>
    document.addEventListener('DOMContentLoaded', function () {
        @* ФОРМА ДЛЯ РЕДАГУВАННЯ ПРОФІЛЮ *@
    const editButton = document.querySelector('.edit-profile-button');
        const originalForm = document.querySelector('.personal-info .info');
        const editForm = document.querySelector('.personal-info .editform')
        const closeEditForm = document.getElementById('close-profile-button');

        @* ФОРМА ДЛЯ РЕДАГУВАННЯ АДРЕСИ *@
    const openAddressForm = document.querySelector('.main-button.add-address-button');
        const originalAddressForm = document.querySelector('.personal-info.my-address .info');
