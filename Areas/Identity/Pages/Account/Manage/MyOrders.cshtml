<div class="my-orders">
    <h3>Мої замовлення</h3>
    @if (orders != null && orders.Any())
    {
        @foreach (var order in orders)
        {
            <div class="order">
                <div class="order-info">
                    <div class="info">
                        <p class="info-label">Номер замовлення</p>
                        <p>#@order.Id</p>
                    </div>
                    <div class="info">
                        <p class="info-label">Дата замовлення</p>
                        <p>@order.OrderDate.ToString("d MMMM yyyy hh:mm", CultureInfo.GetCultureInfo("uk-UA"))</p>
                    </div>
                    <div class="info">
                        <p class="info-label">Дата доставки</p>
                        <p>@order.DeliveryDate.ToString("d MMMM yyyy", CultureInfo.GetCultureInfo("uk-UA"))</p>
                    </div>
                    <div class="info">
                        <p class="info-label">Адреса доставки</p>
                        <p>@(ViewData["userTown"]), Україна</p>
                    </div>
                </div>

                <h3 style="margin-left: 30px;">Товари</h3>
                <div class="custom-line"></div>

                @foreach (var orderitem in order.OrderItems)
                {
                    <div class="ordered-item">
                        <img src="@(orderitem.Product.ImageUrl ?? "~/images/item1.png")" alt="item" />
                        <div class="item-info">
                            <p>@orderitem.Product.Name</p>
                            <label class="order-label">Колір:</label>
                            <p class="order-label-item">@orderitem.Colors</p>
                            <br />
                            <label class="order-label">Розмір:</label>
                            <p class="order-label-item">@orderitem.Size</p>
                            <br />
                            <label class="order-label">Ціна:</label>
                            <p class="order-label-item">@orderitem.Product.Price UAH</p>
                            <br />
                            <label class="order-label">Кількість:</label>
                            <p class="order-label-item">@orderitem.Quantity</p>
                            <br />
                        </div>
                    </div>
                    <div class="custom-line"></div>
                }
                <div class="payment-info">
                    <p class="payment-label">Вартість замовлення</p>
                    <br />
                    <p class="payment-overall-label">Сума товарів:</p>
                    <label>@order.TotalAmount UAH</label>
                    <br />
                    <p class="payment-overall-label">Сума знижки:</p>
                    <label>@order.SaleTotal UAH</label>
                    <br />
                    <p class="payment-overall-label">Вартість доставки:</p>
                    <label>@order.DeliveryPrice UAH</label>
                    <br />
                    <br />
                    <p class="payment-overall-label payment-sum">Оплата:</p>
                    <label class="overall-sum">@order.TotalAmount UAH</label>
                </div>
                <div class="custom-line"></div>
                <div class="additional-order-info">
                    <div class="shipment-type">
                        <p class="label">Вид доставки</p>
                        <div class="info">
                            @if (order.Delivery == "Meest")
                            {
                                <img src="~/images/meest.png" alt="icon-shipment" />
                                <p>Кур'єром Meest Пошта</p>
                            }
                            else if (order.Delivery == "Нова пошта")
                            {
                                <img src="~/images/nova_poshta.png" alt="icon-shipment" />
                                <p>Нова пошта</p>
                            }
                        </div>
                    </div>
                    <div class="payment-type">
                        <p class="label">Спосіб оплати</p>
                        <div class="info">
                            @if (order.Payment == "Visa")
                            {
                                <img src="~/images/visa.png" alt="icon-payment" />
                                <p>Оплата карткою Visa</p>
                            }
                            else if (order.Payment == "MasterCard")
                            {
                                <img src="~/images/mastercard.png" alt="icon-payment" />
                                <p>Оплата карткою Mastercard</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p>Ваш список замовлень наразі порожній.<br />Щойно ви зробите перше замовлення, воно з’явиться тут і ви зможете
            переглядати його статус та деталі доставки.</p>
    }
</div>