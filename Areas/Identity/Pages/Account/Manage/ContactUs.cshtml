@page
@model answer_ua.Areas.Identity.Pages.Account.Manage.ContactUs
@{
    ViewData["Title"] = "Contact Us";

    var subjects = new List<string>
{
"Товар",
"Замовлення",
"Акаунт Клієнта",
"Доставка та оплата",
"Рекламація",
"Повернення товару",
"QUESTION CLUB",
"Відгук про застосунок",
"Інше"
};
}

<style>
    h1,
    h2,
    hr {
        display: none;
    }
</style>


