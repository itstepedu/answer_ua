@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Two-factor authentication (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<style>
    h1,
    h2,
    hr {
        display: none;
    }
</style>

<div class="default-page">
    <partial name="_StatusMessage" for="StatusMessage" />
    @{
        var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
        @if (consentFeature?.CanTrack ?? true)
        {
            @if (Model.Is2faEnabled)
            {
                if (Model.RecoveryCodesLeft == 0)
                {
                    <div class="alert alert-danger">
                        <strong>У вас не залишилося кодів відновлення.</strong>
                        <p>Ви повинні <a asp-page="./GenerateRecoveryCodes">згенерувати новий набір кодів відновлення</a> , перш ніж
                            зможете увійти за допомогою коду відновлення.</p>
                    </div>
                }
                else if (Model.RecoveryCodesLeft == 1)
                {
                    <div class="alert alert-danger">
                        <strong>У вас залишився 1 код відновлення.</strong>
                        <p>Ви можете <a asp-page="./GenerateRecoveryCodes">згенерувати новий набір кодів відновлення</a>.</p>
                    </div>
                }
                else if (Model.RecoveryCodesLeft <= 3)
                {
                    <div class="alert alert-warning">
                        <strong>У вас залишилося @Model.RecoveryCodesLeft кодів відновлення.</strong>
                        <p>Вам слід <a asp-page="./GenerateRecoveryCodes">згенерувати новий набір кодів відновлення</a>.</p>
                    </div>
                }

                if (Model.IsMachineRemembered)
                {
                    <form method="post" style="display: inline-block">
                        <button type="submit" class="main-button-for-link reset">Забути цей браузер</button>
                    </form>
                }
                <a asp-page="./Disable2fa" class="main-button-for-link reset">Вимкнути двофакторну автентифікацію (2FA)</a>
                <a asp-page="./GenerateRecoveryCodes" class="main-button-for-link reset">Скинути коди відновлення</a>
            }

            <h3>Двофакторна аутентифікація</h3>
            @if (!Model.HasAuthenticator)
            {
                <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="main-button-for-link">Додати сторонній додаток для
                    автентифікації</a>
            }
            else
            {
                <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="main-button-for-link">Налаштувати</a>
                <br />
                <br />
                <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="main-button-for-link reset">Скинути</a>
            }
        }
        else
        {
            <div class="alert alert-danger">
                <strong>Політика конфіденційності та використання файлів cookie не була прийнята.</strong>
                <p>Ви повинні прийняти політику, перш ніж зможете увімкнути двофакторну автентифікацію.</p>
            </div>
        }
    }
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}