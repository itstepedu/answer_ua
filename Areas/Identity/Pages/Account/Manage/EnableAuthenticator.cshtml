@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure authenticator app";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<style>
    h1,
    h2,
    hr {
        display: none;
    }
</style>

<partial name="_StatusMessage" for="StatusMessage" />
<div class="default-page">
    <h3>Налаштування автентифікації</h3>
    <p>Щоб скористатися додатком автентифікації, виконайте наступні кроки:</p>
    <ol class="list">
        <li>
            <p>
                Завантажте додаток для двофакторної автентифікації, наприклад Microsoft Authenticator для
                <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> та
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a> або
                Google Authenticator для
                <a
                    href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android</a>
                та
                <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>.
            </p>
        </li>
        <li>
            <p>Введіть цей ключ <kbd>@Model.SharedKey</kbd> у свій додаток двофакторної автентифікації.
                Пробіли та регістр літер значення не мають.</p>
            <div id="qrCode"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>
        <li>
            <p>
                Після того як ви відскануєте QR-код або введете ключ вище, ваш додаток двофакторної автентифікації
                згенерує унікальний код. Введіть цей код у полі підтвердження нижче.</p>
            <div class="row">
                <div class="col-md-6">
                    <form id="send-code" method="post">
                        <label class="register-label">Вкажіть код підтвердження*:</label>
                        <div class="mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off"/>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="main-button">Підтвердити</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}