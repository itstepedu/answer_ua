@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<style>
    h1,
    h2,
    hr {
        display: none;
    }
</style>

<div class="default-page">
    <h3>Видалити акаунт</h3>

    <p>Видалення цих даних назавжди видалить ваш акаунт, і його не можна буде відновити.</p>

    <div>
        <form id="delete-user" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <label asp-for="Input.Password" class="register-label">Введіть пароль:</label><br>
            @if (Model.RequirePassword)
            {
                <div class="mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                        aria-required="true" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
            }
            <button class="main-button" type="submit">Видалити дані та закрити мій акаунт</button>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}