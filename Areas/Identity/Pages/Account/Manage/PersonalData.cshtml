@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<style>
    h1,
    h2,
    hr {
        display: none;
    }
</style>

<div class="default-page">
    <h3>Персональні дані</h3>
    <div class="col-md-6">
        <p>Ваш обліковий запис містить особисті дані, які ви нам надали. На цій сторінці ви можете завантажити або видалити ці дані.</p>
        <p>
            <strong>Після видалення цих даних ваш обліковий запис буде остаточно видалено, і відновити його надалі не буде можливості.</strong>
        </p>
        <form id="download-data" asp-page="DownloadPersonalData" method="post">
            <button class="main-button" type="submit">Завантажити</button>
        </form>
        <br />
        <p>
            <a id="delete" asp-page="DeletePersonalData" class="main-button-for-link delete">Видалити</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}