@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Забули свій пароль?";
}

<div class="reset-password">
    <h3>@ViewData["Title"]</h3>
    <div class="row">
        <div class="col-md-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" style="font-size: .875rem; margin-top: 10px;" role="alert"></div>
                <label class="register-label">Вкажіть свою елетронну пошту*:</label>
                <div class="mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true"/>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="main-button">Скинути</button>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}