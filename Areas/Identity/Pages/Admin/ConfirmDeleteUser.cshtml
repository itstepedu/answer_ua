@page
@model answer_ua.Areas.Identity.Pages.Admin.ConfirmDeleteUser
@{
    ViewData["Title"] = "ConfirmDeleteUser";
    var user = Model.UserToDelete;
}

<div style="padding: 50px;">
    @if (user == null)
    {
        <h3>User not found.</h3>
        <a asp-page="Dashboard" class="btn btn-secondary">Return</a>
    }
    else
    {
        <h3>Are you sure you want to delete user @user.Email?</h3>
        <form method="post">
            <button type="submit" class="main-button-submit main-button-delete">Delete</button>
            <button type="button" class="main-button-submit main-button-cancel"
                onclick="location.href='@Url.Page("Dashboard")'">
                Cancel
            </button>

        </form>
    }
</div>