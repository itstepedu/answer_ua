@page
@model answer_ua.Areas.Identity.Pages.Admin.EditUser
@{
    ViewData["Title"] = "Edit User";
    var user = Model.UserToEdit;

    var userRegion = user.Addresses.FirstOrDefault()?.Region;
    var userRole = Model.UserRole;
    var regions = new List<string>
{
"АР Крим",
"Вінницька",
"Волинська",
"Дніпропетровська",
"Донецька",
"Житомирська",
"Закарпатська",
"Запорізька",
"Івано-Франківська",
"Київська",
"Кіровоградська",
"Луганська",
"Львівська",
"Миколаївська",
"Одеська",
"Полтавська",
"Рівненська",
"Сумська",
"Тернопільська",
"Харківська",
"Херсонська",
"Хмельницька",
"Черкаська",
"Чернівецька",
"Чернігівська"
};

    var roles = new List<string>{
"Admin",
"User",
};
}

<div class="edit-user" style="padding: 50px;">
    <div class="page-title" style="margin-bottom: 20px;">
        <h3>Редагувати користувача</h3>
    </div>
    <form method="post" class="row g-3">
        <div class="col-md-6">
            <label for="inputEmail" class="form-label">Електронна пошта</label>
            <input type="email" class="form-control" name="inputEmail" id="inputEmail" value="@user.Email">
        </div>
        <div class="col-md-6">
            <label for="inputPhone" class="form-label">Телефон</label>
            <input type="tel" class="form-control" name="inputPhone" id="inputPhone" value="@user.PhoneNumber">
        </div>
        <div class="col-md-6">
            <label for="inputFirstName" class="form-label">Ім'я</label>
            <input type="text" class="form-control" name="inputFirstName" id="inputFirstName" value="@user.FirstName">
        </div>
        <div class="col-md-6">
            <label for="inputLastName" class="form-label">Прізвище</label>
            <input type="text" class="form-control" name="inputLastName" id="inputLastName" value="@user.LastName">
        </div>
        <div class="col-md-6">
            <label for="inputDate" class="form-label">Дата народження</label>
            <input type="date" step="any" class="form-control" name="inputDate" id="inputDate"
                value="@user.DateOfBirth.ToString("yyyy-MM-dd")">
        </div>
        <div class="col-md-6">
            <label for="inputRole" class="form-label">Роль</label>
            <select id="inputRole" name="inputRole" class="form-select">
                <option selected disabled>Оберіть роль...</option>
                @foreach (var role in roles)
                {
                    <option value="@role" selected="@(role == userRole ? "selected" : null)">
                        @role
                    </option>
                }
            </select>
        </div>
        <div class="col-12">
            <label for="inputAddress" class="form-label">Адреса (вулиця, будинок, квартира)</label>
            <input type="text" class="form-control" name="inputAddress" id="inputAddress"
                value="@user.Addresses.FirstOrDefault()?.StreetAddress">
        </div>
        <div class="col-12">
            <label for="inputAddress2" class="form-label">Додаткова адреса (вулиця, будинок,
                квартира)</label>
            <input type="text" class="form-control" name="inputAddress2" id="inputAddress2"
                value="@user.Addresses.FirstOrDefault()?.SecondStreetAddress">
        </div>
        <div class="col-md-6">
            <label for="inputCity" class="form-label">Місто/село</label>
            <input type="text" class="form-control" name="inputCity" id="inputCity"
                value="@user.Addresses.FirstOrDefault()?.City">
        </div>

        <div class="col-md-4">
            <label for="inputRegion" class="form-label">Область</label>
            <select name="inputRegion" id="inputRegion" class="form-select">
                <option selected disabled>Оберіть область...</option>
                @foreach (var region in regions)
                {
                    <option value="@region" selected="@(region == userRegion ? "selected" : null)">
                        @region
                    </option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label for="inputZip" class="form-label">Поштовий індекс</label>
            <input type="text" class="form-control" name="inputZip" id="inputZip"
                value="@user.Addresses.FirstOrDefault()?.PostalCode">
        </div>

        <div class="col-md-6">
            <label for="inputPoints" class="form-label">Накопичені бали</label>
            <input type="number" step="any" class="form-control" name="inputPoints" id="inputPoints"
                value="@user.AccumulatedPoints">
        </div>
        <div class="col-md-6">
            <label for="inputDiscount" class="form-label">Постійна знижка</label>
            <input type="number" step="any" class="form-control" name="inputDiscount" id="inputDiscount"
                value="@user.PermanentDiscount">
        </div>

        <div class="buttons" style="display: flex; margin: 0; padding: 0;">
            <button class="main-button-submit" type="submit">Зберегти</button>
            <button type="button" class="main-button-submit main-button-cancel-edit"
                onclick="location.href='@Url.Page("DashboardUsers")'">
                Повернутися
            </button>
        </div>
    </form>
</div>