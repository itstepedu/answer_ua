@page
@using System.Drawing
@model answer_ua.Areas.Identity.Pages.Admin.EditItem
@{
    ViewData["Title"] = "EditItem";
    var product = Model.ProductToEdit;
    var brands = Model.Brands;
    var targets = Model.Targets;
    var types = Model.Types;
    var subcategories = Model.Subcategories;
    var additional_photos = product.Images;

    string[]? sizes = (product.Size ?? "")
    .Split((char[])null, StringSplitOptions.RemoveEmptyEntries)
    .Select(s => s.Trim())
    .ToArray();

    string[]? colors = (product.Color ?? "")
    .Split((char[])null, StringSplitOptions.RemoveEmptyEntries)
    .Select(c => c.Trim())
    .ToArray();

    string[]? sizesInput = product.Size.Split(new[] { "\r\n", "\n" }, StringSplitOptions.None);

    string[]? colorsInput = product.Color.Split(new[] { "\r\n", "\n" }, StringSplitOptions.None);

    int photoNumber = 1;
}


<div class="edit-item" style="padding: 50px;">
    <div class="page-title" style="margin-bottom: 20px;">
        <h3>Редагувати товар</h3>
    </div>
    <form method="post" class="row g-3">
        <div class="col-md-6">
            <label for="inputBrand" class="form-label">Бренд</label>
            <select name="inputBrand" id="inputBrand" class="form-select">
                <option selected disabled>Оберіть бренд...</option>
                @foreach (var brand in brands)
                {
                    <option value="@brand.Id" selected="@(brand.Id == product.BrandsId ? "selected" : null)">
                        @brand.Name
                    </option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label for="inputName" class="form-label">Назва</label>
            <input type="text" class="form-control" name="inputName" id="inputName" value="@product.Name">
        </div>

        <div class="col-md-6">
            <label for="inputTarget" class="form-label">Цільова категорія</label>
            <select name="inputTarget" id="inputTarget" class="form-select">
                <option selected disabled>Оберіть цільову категорію...</option>
                @foreach (var target in targets)
                {
                    <option value="@target.Id" selected="@(target.Id == product.TargetCategoriesId ? "selected" : null)">
                        @target.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-6">
            <label for="inputType" class="form-label">Тип товару</label>
            <select name="inputType" id="inputType" class="form-select">
                <option selected disabled>Оберіть тип товару...</option>
                @foreach (var type in types)
                {
                    <option value="@type.Id" selected="@(type.Id == product.ProductTypesId ? "selected" : null)">
                        @type.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-12">
            <label for="inputSubcategory" class="form-label">Підкатегорія</label>
            <select name="inputSubcategory" id="inputSubcategory" class="form-select">
                <option selected disabled>Оберіть підкатегорію...</option>
                @foreach (var subcategory in subcategories)
                {
                    <option value="@subcategory.Id"
                        selected="@(subcategory.Id == product.SubcategoriesId ? "selected" : null)">
                        @subcategory.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-6">
            <label for="inputSize" class="form-label">Розміри</label>
            <ul>
                @foreach (var size in sizes)
                {
                    <li>@size</li>
                }
            </ul>
        </div>

        <div class="col-md-6">
            <label for="inputColor" class="form-label">Кольори</label>
            <ul>
                @foreach (var color in colors)
                {
                    <li>@color</li>
                }
            </ul>
        </div>

        <div style="display: flex; justify-content: left; margin: 0; padding: 0;">
            <button type="button" class="main-button-submit add-size">Змінити розміри</button>
        </div>

        <div style="display: flex; justify-content: left; margin: 0; padding: 0;">
            <button type="button" class="main-button-submit add-color">Змінити кольори</button>
        </div>

        <div class="col-md-6 form-sizes" style="display: none;">
            <label for="inputSize" class="form-label">Розміри</label>
            <input type="text" class="form-control" name="inputSize" id="inputSize"
                value="@string.Join(", ", sizesInput)">
        </div>

        <div class="col-md-6 form-colors" style="display: none;">
            <label for="inputColor" class="form-label">Кольори</label>
            <input type="text" class="form-control" name="inputColor" id="inputColor"
                value="@string.Join(", ", colorsInput)">
        </div>

        <div class="col-md-6">
            <label for="inputStock" class="form-label">Кількість на складі</label>
            <input type="number" class="form-control" name="inputStock" id="inputStock" value="@product.Stock">
        </div>
        <div class="col-md-6">
            <label for="inputPrice" class="form-label">Ціна</label>
            <input type="number" class="form-control" name="inputPrice" id="inputPrice" value="@product.Price">
        </div>
        <div class="col-12">
            <label for="inputURL" class="form-label">URL основного зображення</label>
            <input type="text" class="form-control" name="inputURL" id="inputURL" value="@product.ImageUrl">
        </div>

        <label for="inputAdditionalURL" class="form-label">Додаткові фото</label>
        @foreach (var photo in additional_photos)
        {
            <div class="col-12">
                <label for="inputAdditionalURL" class="form-label">Фото №@photoNumber</label>
                <input type="text" class="form-control" name="inputAdditionalURL" id="inputAdditionalURL" value="@photo.ImageUrl">
            </div>
            photoNumber++;
        }
        <button class="main-button-submit" type="submit">Зберегти</button>
        <button type="button" class="main-button-submit main-button-cancel-edit"
            onclick="location.href='@Url.Page("DashboardItems")'">
            Повернутися
        </button>
    </form>
</div>


<script>
    const addColorToItem = document.querySelector('.main-button-submit.add-color');
    const addSizeToItem = document.querySelector('.main-button-submit.add-size');

    const formToAddColor = document.querySelector(".col-md-6.form-colors");
    const formToAddSize = document.querySelector(".col-md-6.form-sizes");

    addColorToItem.addEventListener('click', function () {
        formToAddColor.style.display = 'block';
        //formToAddItem.appendChild(newDeleteButton);
    });

    addSizeToItem.addEventListener('click', function () {
        formToAddSize.style.display = 'block';
    });



</script>