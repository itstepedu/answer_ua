@page
@model answer_ua.Areas.Identity.Pages.Admin.DashboardItems
@{
    ViewData["Title"] = "DashboardItems";
    var products = Model.products;
}


@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
}


<div style="padding: 50px;">
    <div class="wrapper">
        <div id="body" class="active">
            <div class="content">
                <div class="container">
                    <div class="page-title">
                        <h3>Items
                            <a asp-page="AddUser" class="btn btn-sm btn-outline-primary float-end"><i
                                    class="fas fa-user-plus"></i> Add</a>
                        </h3>
                    </div>
                    <div class="box box-primary">
                        <div class="box-body">
                            <table width="100%" class="table table-hover" id="items-table">
                                <thead>
                                    <tr>
                                        <th data-column="brand" data-order="desc">Brand </th>
                                        <th data-column="name" data-order="desc">Name </th>
                                        <th data-column="target" data-order="desc">Target category </th>
                                        <th data-column="type" data-order="desc">Type </th>
                                        <th data-column="subcategory" data-order="desc">Subcategory </th>
                                        <th data-column="stock" data-order="desc">Stock </th>
                                        <th data-column="price" data-order="desc">Price </th>
                                        <th class="no-sort"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in products)
                                    {
                                        <tr>
                                            <td>@product.Brands.Name</td>
                                            <td>@product.Name</td>
                                            <td>@product.TargetCategories.Name</td>
                                            <td>@product.ProductTypes.Name</td>
                                            <td>@product.Subcategories.Name</td>
                                            <td>@product.Stock</td>
                                            <td data-order="@product.Price">@product.Price.ToString("0.00") UAH</td>
                                            <td class="text-end">

                                                <a asp-page="EditUser" asp-route-id=""
                                                    class="btn btn-outline-info btn-rounded"><i class="fas fa-pen"></i></a>

                                                <a asp-page="ConfirmDeleteUser" asp-route-id=""
                                                    class="btn btn-outline-danger btn-rounded"><i
                                                        class="fas fa-trash"></i></a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#items-table').DataTable();
        });
    </script>
}