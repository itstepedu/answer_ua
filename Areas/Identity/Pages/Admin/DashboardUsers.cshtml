@page
@using System.Globalization
@model answer_ua.Areas.Identity.Pages.Admin.DashboardUsers
@{
    ViewData["Title"] = "Dashboard";
    var users = Model.Users;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
}

<div style="padding: 50px;">
    <div class="wrapper">
        <div id="body" class="active">
            <div class="content">
                <div class="container">
                    <div class="page-title">
                        <h3>Користувачі
                            <a asp-page="AddUser" class="float-end main-button-for-link">Додати</a>
                        </h3>
                    </div>
                    <div class="box box-primary">
                        <div class="box-body">
                            <table width="100%" class="table table-hover" id="users-table">
                                <thead>
                                    <tr>
                                        <th>Повне ім'я</th>
                                        <th>Електронна пошта</th>
                                        <th>Телефон</th>
                                        <th>Дата народження</th>
                                        <th>Пошта підтверджена</th>
                                        <th>Роль</th>
                                        <th class="no-sort"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach(var user in users){
                                    <tr>
                                        <td>@(user.FirstName ?? "[Ім’я не вказано]") @(user.LastName ?? "[Прізвище не вказано]")</td>
                                        <td>@user.Email</td>
                                        <td>@(user.PhoneNumber ?? "[Телефон не вказано]")</td>
                                        <td>@(user.DateOfBirth != default(DateTime) ? user.DateOfBirth.ToString("d MMMM yyyy", CultureInfo.GetCultureInfo("uk-UA")) : "[Дата народження не вказана]")</td>
                                        <td>
                                            @if (user.EmailConfirmed)
                                            {
                                                <span>Підтверджено</span>
                                            }
                                            else
                                            {
                                                <span>Не підтверджено</span>
                                            }
                                        <td>@user.Role</td>
                                        <td class="text-end">
                                        @if (user.Email != "admin_answer@gmail.com"){

                                        <a asp-page="EditUser" asp-route-id="@user.Id" class="btn btn-outline-info btn-rounded"><i
                                                    class="fas fa-pen"></i></a> 

                                        <a asp-page="ConfirmDeleteUser" asp-route-id="@user.Id" class="btn btn-outline-danger btn-rounded"><i
                                                    class="fas fa-trash"></i></a> 
                                        }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/plug-ins/1.13.6/i18n/uk.json"></script>

    <script>
       $(document).ready(function () {
            $('#users-table').DataTable({
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/uk.json"
                }
            });

            setTimeout(function () {
                $('#users-table_filter input').removeAttr('placeholder');
            }, 0);
        });

        
    </script>
}