@page
@model answer_ua.Areas.Identity.Pages.Admin.AddOrder
@{
    ViewData["Title"] = "AddOrder";
    var users = Model.Users;
}


<div style="padding: 50px;">
    <div class="page-title" style="margin-bottom: 20px;">
        <h3>Додати замовлення</h3>
    </div>

    <form method="post" class="row g-3">
        <div class="col-12">
            <label for="inputEmail" class="form-label">Пошта користувача</label>
            <select name="inputEmail" id="inputEmail" class="form-select">
                <option selected disabled>Оберіть користувача...</option>
                @foreach (var user in users)
                {
                    <option value="@user.Email">
                        @user.Email
                    </option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label for="inputDateOfOrder" class="form-label">Дата замовлення</label>
            <input style="height: 38px;" type="date" class="form-control" name="inputDateOfOrder" id="inputDateOfOrder">
        </div>
        <div class="col-md-6">
            <label for="inputTotalAmount" class="form-label">Загальна сума</label>
            <input type="number" class="form-control" name="inputTotalAmount" id="inputTotalAmount" value="0" disabled>
        </div>
        <div style="margin: 0; padding: 0;">
            <button class="main-button-submit" type="submit">Додати</button>
        </div>
    </form>
</div>