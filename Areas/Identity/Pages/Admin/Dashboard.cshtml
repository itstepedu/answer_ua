@page
@model answer_ua.Areas.Identity.Pages.Admin.Dashboard
@{
    ViewData["Title"] = "Dashboard";
    var users = Model.Users;
}

<h1>@ViewData["Title"]</h1>

<div>
    <div class="wrapper">
        <div id="body" class="active">
            <div class="content">
                <div class="container">
                    <div class="page-title">
                        <h3>Users
                            <a asp-page="AddUser" class="btn btn-sm btn-outline-primary float-end"><i
                                    class="fas fa-user-plus"></i> Add</a>
                        </h3>
                    </div>
                    <div class="box box-primary">
                        <div class="box-body">
                            <table width="100%" class="table table-hover" id="dataTables-example">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Phone Number</th>
                                        <th>Date of Birth</th>
                                        <th>Role</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach(var user in users){
                                    <tr>
                                        <td>@(user.FirstName ?? "[No First Name]") @(user.LastName ?? "[No LastName]")</td>
                                        <td>@user.Email</td>
                                        <td>@(user.PhoneNumber ?? "[No Phone Number]")</td>
                                        <td>@(user.DateOfBirth != default(DateTime) ? user.DateOfBirth.ToString("MMMM d, yyyy") : "[No Date of Birth]")</td>
                                        <td>@user.Role</td>
                                        <td class="text-end">
                                        @if (user.Email != "admin_answer@gmail.com"){

                                        <a asp-page="EditUser" asp-route-id="@user.Id" class="btn btn-outline-info btn-rounded"><i
                                                    class="fas fa-pen"></i></a> 

                                        <a asp-page="ConfirmDeleteUser" asp-route-id="@user.Id" class="btn btn-outline-danger btn-rounded"><i
                                                    class="fas fa-trash"></i></a> 
                                        }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>